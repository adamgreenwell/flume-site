# Renders a fixture release so the download and changelog pages can be worked
# on before 1.0 is tagged. See src/lib/releases.ts. Copy to .env to use.
FLUME_FAKE_RELEASE=1

# Optional. Only needed while adamgreenwell/flume is private — an
# unauthenticated build gets a 404 from the releases API and falls back to the
# "nothing published yet" state. Fine-grained token, read-only Contents.
# GITHUB_TOKEN=
