---
/**
 * A static replica of Flume's library window.
 *
 * Rebuilt in markup rather than screenshotted, for three reasons: it stays
 * sharp on any display, it follows the site's theme so a light-mode visitor
 * sees the light app, and it cannot go stale in the silent way a PNG does —
 * when the app's tokens move, this moves with them.
 *
 * Geometry is transcribed from the app: 58px comfortable rows, an 18px status
 * ring, the 180px progress column, 86px rate cells, and the piece strip's
 * 22px/16px stacked pair with its 1px gaps. The availability bars use the
 * app's own rule — a region no peer holds is drawn full height in the error
 * colour, and held regions are capped at 80% so a zero always stands taller.
 *
 * The figures below are plausible, not real. They describe the case the piece
 * map exists to show: a torrent that is 61% done and healthy, next to one that
 * has a gap no connected peer can fill.
 */

/**
 * Deterministic PRNG, so the strip is identical on every build.
 *
 * `Math.random()` here would mean a different hero in every deploy and a
 * pointless diff in any visual comparison.
 */
function rng(seed: number) {
  let s = seed;
  return () => {
    s = (s * 1664525 + 1013904223) % 4294967296;
    return s / 4294967296;
  };
}

const CELLS = 96;

/**
 * Completion levels for the upper strip, in the app's three bands:
 * verified (`acc-dim`), in flight (`acc`), not requested (`bg-3`).
 *
 * Shaped as a rarest-first download — a solid head, then scattered verified
 * blocks through the middle and tail, which is what the app draws when the
 * engine is not pulling in order.
 */
const done = rng(20260830);
const pieces = Array.from({ length: CELLS }, (_, i) => {
  const head = i < CELLS * 0.42;
  const roll = done();
  if (head) return roll > 0.06 ? "verified" : "flight";
  if (roll > 0.62) return "verified";
  if (roll > 0.52) return "flight";
  return "empty";
});

/**
 * Copies of each region across connected peers, for the lower strip.
 *
 * Deliberately thinning toward the tail, with one region at zero — the shape
 * the docs describe as "a torrent heading for a stall".
 */
const avail = rng(77021);
const peak = 9;
const copies = Array.from({ length: CELLS }, (_, i) => {
  const thinning = 1 - (i / CELLS) * 0.62;
  return Math.max(1, Math.round((2 + avail() * 7) * thinning));
});
copies[78] = 0;
copies[79] = 0;

const rows = [
  {
    name: "ubuntu-24.04.1-desktop-amd64.iso",
    size: "5.70 GB",
    detail: "61% · 12 min left · 24 peers",
    percent: 61,
    state: "downloading",
    down: "6.6 MB/s",
    up: "1.2 MB/s",
    health: "healthy",
    healthLabel: "Healthy",
    selected: true,
  },
  {
    name: "debian-12.7.0-amd64-DVD-1.iso",
    size: "3.72 GB",
    detail: "34% · 41 min left · 6 peers",
    percent: 34,
    state: "downloading",
    down: "1.4 MB/s",
    up: "0 B/s",
    health: "thin",
    healthLabel: "Thin swarm",
  },
  {
    name: "Fedora-Workstation-Live-41-1.4.x86_64.iso",
    size: "2.23 GB",
    detail: "Complete · ratio 2.14 · 11 peers",
    percent: 100,
    state: "seeding",
    down: "0 B/s",
    up: "3.9 MB/s",
    health: "seeding",
    healthLabel: "Seeding",
  },
  {
    name: "AlmaLinux-9.4-x86_64-dvd.iso",
    size: "11.4 GB",
    detail: "Paused at 88%",
    percent: 88,
    state: "paused",
    down: "0 B/s",
    up: "0 B/s",
    health: "idle",
    healthLabel: "Idle",
  },
  {
    name: "rocky-9.4-x86_64-minimal.iso",
    size: "2.44 GB",
    detail: "72% · stalled · no peer holds 3.1% of pieces",
    percent: 72,
    state: "downloading",
    down: "0 B/s",
    up: "184 KB/s",
    health: "none",
    healthLabel: "No seeds",
  },
];

const rails = [
  { label: "All", count: 5, current: true },
  { label: "Downloading", count: 3 },
  { label: "Seeding", count: 1 },
  { label: "Paused", count: 1 },
];

/**
 * Per-row animation parameters, handed to the client script.
 *
 * `gain` is percentage points per second, chosen so the two live downloads
 * advance visibly over the time someone spends reading the hero without
 * either completing — a bar that fills and stops would be a worse picture of
 * the app than one that is still going.
 */
const motion = rows.map((r) => ({
  state: r.state,
  percent: r.percent,
  gain: r.state === "downloading" && r.down !== "0 B/s" ? 0.11 : 0,
  down: r.down,
  up: r.up,
}));
---

<div
  class="app"
  data-app
  role="img"
  aria-label="The Flume library window, showing five Linux ISO torrents. The selected torrent is 61 percent complete with a healthy swarm; its piece map shows which regions are verified and how many connected peers hold each one."
>
  <div class="app__bar">
    <span class="app__dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="app__title">Flume</span>
    <span class="app__status">
      <span class="app__dot"></span>
      <span class="num">Ready · DHT <span data-dht>214</span> nodes</span>
    </span>
  </div>

  <div class="app__body">
    <aside class="rail">
      {
        rails.map((r) => (
          <span class:list={["rail__item", r.current && "is-current"]}>
            <span>{r.label}</span>
            <span class="num rail__count">{r.count}</span>
          </span>
        ))
      }
      <span class="rail__spacer"></span>
      <span class="rail__add">
        <svg
          width="14"
          height="14"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M8 3.5v9M3.5 8h9"></path>
        </svg>
        Add torrent
      </span>
    </aside>

    <div class="list">
      <div class="list__head">
        <span class="list__h list__h--name">Name</span>
        <span class="list__h list__h--prog">Progress</span>
        <span class="list__h list__h--rate">Down</span>
        <span class="list__h list__h--rate">Up</span>
        <span class="list__h list__h--health">Health</span>
      </div>

      {
        rows.map((row) => (
          <div class:list={["row", row.selected && "is-selected"]} data-row>
            <span class:list={["row__ring", `is-${row.state}`]}>
              <svg
                width="11"
                height="11"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                {row.state === "downloading" && (
                  <path d="M8 2.6v8.4M4.6 7.6 8 11l3.4-3.4M3 13.4h10" />
                )}
                {row.state === "seeding" && (
                  <path d="M8 13.4V5M4.6 8.4 8 5l3.4 3.4M3 2.6h10" />
                )}
                {row.state === "paused" && (
                  <path d="M6.2 3.6v8.8M9.8 3.6v8.8" />
                )}
              </svg>
            </span>

            <span class="row__name">
              <span class="row__title">{row.name}</span>
              <span class="row__meta">
                <span class="num">{row.size}</span>
                <span class="row__sep">·</span>
                <span class="row__detail">{row.detail}</span>
              </span>
            </span>

            <span class="row__prog">
              <span class="track">
                <span
                  class:list={["fill", `is-${row.state}`]}
                  style={`width:${row.percent}%`}
                />
              </span>
              <span class="num row__pct">{row.percent}%</span>
            </span>

            <span
              class:list={[
                "num",
                "row__rate",
                row.down === "0 B/s" && "is-zero",
              ]}
            >
              {row.down}
            </span>
            <span
              class:list={[
                "num",
                "row__rate",
                "is-up",
                row.up === "0 B/s" && "is-zero",
              ]}
            >
              {row.up}
            </span>

            <span class="row__health">
              <span class:list={["chip", `is-${row.health}`]}>
                <span class="chip__dot" aria-hidden="true" />
                {row.healthLabel}
              </span>
            </span>
          </div>
        ))
      }

      <div class="detail">
        <div class="detail__head">
          <span class="eyebrow"
            >Piece map — ubuntu-24.04.1-desktop-amd64.iso</span
          >
          <span class="num detail__count">
            <span data-verified>2,847</span> of 4,668 pieces
          </span>
        </div>

        <div class="strip" data-strip>
          {pieces.map((p) => <span class:list={["cell", `is-${p}`]} />)}
        </div>
        <div class="strip strip--avail">
          {
            copies.map((c) => (
              <span
                class:list={["bar", c === 0 && "is-zero"]}
                style={`height:${c === 0 ? 100 : Math.max(12, (c / peak) * 80)}%`}
              />
            ))
          }
        </div>

        <div class="legend">
          <span class="legend__item"
            ><i class="sw is-verified"></i>Verified</span
          >
          <span class="legend__item"><i class="sw is-flight"></i>In flight</span
          >
          <span class="legend__item"
            ><i class="sw is-empty"></i>Not requested</span
          >
          <span class="legend__note">
            Every region is held by between <span class="num">1</span>{" "}
            and <span class="num">9</span> connected peers.
          </span>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ motion }}>
  /*
   * Brings the mock to life at 1 Hz — the app's own telemetry rate.
   *
   * The point is not decoration. A torrent client is a live instrument, and
   * every competitor shows theirs as a still photograph. Ticking the figures
   * at the rate the real app ticks them also demonstrates the reason every
   * number is set in tabular figures: the columns do not move as digits
   * change. With a proportional face this would jitter once a second, which is
   * precisely the argument.
   *
   * Three rules keep it from being obnoxious:
   *   - `prefers-reduced-motion` stops it before it starts, leaving the
   *     rendered-at-build-time state on screen. That state is complete and
   *     correct on its own; the animation is strictly additive.
   *   - It runs only while the window is actually on screen, via
   *     IntersectionObserver. Scrolling past it costs nothing.
   *   - Rates random-walk around their starting value rather than being
   *     redrawn at random, so they read as a measurement rather than noise.
   */
  (function () {
    const root = document.querySelector("[data-app]");
    if (!root) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const rows = Array.from(root.querySelectorAll("[data-row]"));
    const cells = Array.from(root.querySelectorAll("[data-strip] .cell"));
    const dht = root.querySelector("[data-dht]");
    const verified = root.querySelector("[data-verified]");

    /** Live state per row, seeded from what the server rendered. */
    const state = motion.map((m) => ({
      ...m,
      // Rates are held in bytes/sec so the walk and the formatting agree.
      downBps: parseRate(m.down),
      upBps: parseRate(m.up),
    }));

    let pieceCount = 2847;

    /** `"6.6 MB/s"` back to bytes per second. */
    function parseRate(text) {
      const value = parseFloat(text);
      if (!Number.isFinite(value)) return 0;
      if (text.includes("MB")) return value * 1e6;
      if (text.includes("KB")) return value * 1e3;
      return value;
    }

    /**
     * The app's `formatSpeed`: one decimal, and MB/s held down to 0.1 so a
     * rate column reads as a single unit rather than switching per row.
     */
    function formatSpeed(bps) {
      if (!Number.isFinite(bps) || bps <= 0) return "0 B/s";
      if (bps >= 100000) {
        const v = bps / 1e6;
        return `${v.toFixed(v < 100 ? 1 : 0)} MB/s`;
      }
      if (bps >= 1000) return `${Math.round(bps / 1e3)} KB/s`;
      return `${Math.round(bps)} B/s`;
    }

    /** The app's `formatDuration`: `1 h 07 min`, `2 min 30 s`, `45 s`. */
    function formatDuration(seconds) {
      const s = Math.max(0, Math.round(seconds));
      if (s >= 3600) {
        const h = Math.floor(s / 3600);
        return `${h} h ${String(Math.floor((s % 3600) / 60)).padStart(2, "0")} min`;
      }
      if (s >= 60)
        return `${Math.floor(s / 60)} min ${String(s % 60).padStart(2, "0")} s`;
      return `${s} s`;
    }

    /** A bounded random walk, so a rate drifts rather than jumping. */
    function walk(value, base, spread) {
      const next = value + (Math.random() - 0.5) * base * spread;
      return Math.min(base * 1.35, Math.max(base * 0.55, next));
    }

    function tick() {
      state.forEach((row, i) => {
        const el = rows[i];
        if (!el) return;

        if (row.gain > 0) {
          row.percent = Math.min(99.4, row.percent + row.gain);

          const fill = el.querySelector(".fill");
          if (fill) fill.style.width = `${row.percent}%`;

          const pct = el.querySelector(".row__pct");
          if (pct) pct.textContent = `${Math.floor(row.percent)}%`;
        }

        if (row.downBps > 0)
          row.downBps = walk(row.downBps, parseRate(row.down), 0.22);
        if (row.upBps > 0) row.upBps = walk(row.upBps, parseRate(row.up), 0.3);

        const rates = el.querySelectorAll(".row__rate");
        if (rates[0] && row.downBps > 0)
          rates[0].textContent = formatSpeed(row.downBps);
        if (rates[1] && row.upBps > 0)
          rates[1].textContent = formatSpeed(row.upBps);

        // The meta line's ETA is recomputed from the rate actually showing,
        // so the sentence and the column never contradict each other.
        const detail = el.querySelector(".row__detail");
        if (detail && row.gain > 0 && row.downBps > 0) {
          const remaining = ((100 - row.percent) / row.gain) * 1;
          const peers = detail.textContent.match(/(\d+) peers/);
          detail.textContent =
            `${Math.floor(row.percent)}% · ${formatDuration(remaining)} left` +
            (peers ? ` · ${peers[1]} peers` : "");
        }
      });

      // The strip is driven by the selected torrent's progress rather than
      // ticking on its own. Left to promote a few cells a second it saturates
      // in about a minute — a full strip sitting above a bar reading 63%,
      // and a legend with no in-flight or not-requested cells left to point
      // at. Deriving the target from the percentage keeps the two halves of
      // the same picture telling the same story.
      const lead = state[0];
      const target = Math.round((lead.percent / 100) * cells.length);
      let verifiedNow = cells.filter((c) =>
        c.classList.contains("is-verified"),
      ).length;

      while (verifiedNow < target) {
        const flight = cells.filter((c) => c.classList.contains("is-flight"));
        const pool = flight.length
          ? flight
          : cells.filter((c) => c.classList.contains("is-empty"));
        if (!pool.length) break;

        const cell = pool[Math.floor(Math.random() * pool.length)];
        cell.className = "cell is-verified";
        verifiedNow += 1;
      }

      // A steady pool of in-flight requests, so the middle band of the legend
      // always has something on screen to refer to.
      const flightNow = cells.filter((c) =>
        c.classList.contains("is-flight"),
      ).length;
      const empty = cells.filter((c) => c.classList.contains("is-empty"));
      for (let n = flightNow; n < 9 && empty.length; n++) {
        const i = Math.floor(Math.random() * empty.length);
        empty[i].className = "cell is-flight";
        empty.splice(i, 1);
      }

      pieceCount = Math.round((lead.percent / 100) * 4668);
      if (verified) verified.textContent = pieceCount.toLocaleString();
      if (dht) dht.textContent = String(210 + Math.floor(Math.random() * 12));
    }

    let timer = null;

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.some((e) => e.isIntersecting);
        if (visible && timer === null) {
          timer = window.setInterval(tick, 1000);
        } else if (!visible && timer !== null) {
          window.clearInterval(timer);
          timer = null;
        }
      },
      { threshold: 0.08 },
    );

    observer.observe(root);
  })();
</script>

<style>
  .app {
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background: var(--bg-0);
    overflow: hidden;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.04) inset,
      0 24px 70px -30px rgba(0, 0, 0, 0.72),
      0 8px 24px -14px rgba(0, 0, 0, 0.5);
    font-size: 13px;
    line-height: 1.45;
    /* The mock is a picture of a desktop app, not body copy. Its own type
       scale is the app's, independent of the site's larger ramp. */
    letter-spacing: normal;
  }

  /* ---- title bar ---- */
  .app__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 38px;
    padding-inline: 13px;
    background: var(--bg-1);
    border-bottom: 1px solid var(--line);
  }

  .app__dots {
    display: flex;
    gap: 6px;
  }

  .app__dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--bg-3);
  }

  .app__title {
    font-size: 12px;
    font-weight: 600;
    color: var(--fg-1);
  }

  .app__status {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: var(--fg-3);
  }

  .app__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ok);
  }

  .app__body {
    display: grid;
    grid-template-columns: 176px minmax(0, 1fr);
  }

  /* ---- rail ---- */
  .rail {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 10px;
    background: var(--bg-1);
    border-right: 1px solid var(--line);
  }

  .rail__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--h-control);
    padding-inline: 10px;
    border-radius: var(--r-md);
    color: var(--fg-2);
    font-size: 12.5px;
  }

  .rail__item.is-current {
    background: var(--bg-3);
    color: var(--fg-0);
    font-weight: 500;
  }

  .rail__count {
    font-size: 11px;
    color: var(--fg-3);
  }

  .rail__spacer {
    flex: 1;
    min-height: 18px;
  }

  .rail__add {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: var(--h-control);
    border-radius: var(--r-md);
    background: var(--acc);
    color: var(--on-acc);
    font-size: 12.5px;
    font-weight: 600;
  }

  /* ---- list ---- */
  .list__head {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 30px;
    padding-inline: 18px;
    border-bottom: 1px solid var(--line);
    color: var(--fg-3);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .list__h--name {
    flex: 1;
    /* Clears the 18px ring plus its 16px gap so the header sits over the
       column it names rather than over the status glyph. */
    margin-left: 34px;
  }
  .list__h--prog {
    width: 180px;
  }
  .list__h--rate {
    width: 86px;
    text-align: right;
  }
  .list__h--health {
    width: 96px;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 58px;
    padding-inline: 18px;
    border-bottom: 1px solid var(--line);
  }

  .row.is-selected {
    background: var(--bg-2);
    box-shadow: inset 2px 0 0 var(--acc);
  }

  .row__ring {
    position: relative;
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    flex: none;
  }

  .row__ring::before {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid currentColor;
    border-radius: 50%;
    opacity: 0.36;
  }

  .row__ring.is-downloading {
    color: var(--acc);
  }
  .row__ring.is-seeding {
    color: var(--ok);
  }
  .row__ring.is-paused {
    color: var(--fg-3);
  }

  .row__name {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .row__title {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.005em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .row__meta {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 11px;
    color: var(--fg-2);
    min-width: 0;
  }

  /* "5.70 GB" is one value. Letting it break after the number turns a size
     into two lines of nonsense on a narrow screen. */
  .row__meta .num {
    white-space: nowrap;
  }

  .row__sep {
    color: var(--fg-3);
  }

  .row__detail {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .row__prog {
    display: flex;
    align-items: center;
    gap: 9px;
    width: 180px;
    flex: none;
  }

  .track {
    flex: 1;
    height: 5px;
    border-radius: 3px;
    background: var(--bg-3);
    overflow: hidden;
  }

  .fill {
    display: block;
    height: 100%;
    border-radius: 3px;
    /* Just under the 1 Hz tick, so the bar is always moving rather than
       stepping and then waiting. */
    transition: width 0.9s linear;
  }

  .fill.is-downloading {
    background: var(--acc);
  }
  .fill.is-seeding {
    background: var(--ok);
  }
  .fill.is-paused {
    background: var(--fg-3);
  }

  .row__pct {
    width: 34px;
    text-align: right;
    font-size: 11px;
    color: var(--fg-2);
  }

  .row__rate {
    width: 86px;
    flex: none;
    text-align: right;
    font-size: 12px;
    color: var(--chart-down);
  }

  .row__rate.is-up {
    color: var(--chart-up);
  }

  /* A measured zero is a different fact from no data, so it dims rather than
     blanking — the app's rule. */
  .row__rate.is-zero {
    color: var(--fg-3);
  }

  .row__health {
    width: 96px;
    flex: none;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 21px;
    padding-inline: 7px 8px;
    border-radius: var(--r-sm);
    font-size: 11px;
    font-weight: 500;
    white-space: nowrap;
  }

  .chip__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
