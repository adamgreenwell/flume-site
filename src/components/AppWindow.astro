---
/**
 * A static replica of Flume's window.
 *
 * Rebuilt in markup rather than screenshotted, so it stays sharp at any
 * resolution, follows the visitor's theme, and cannot go stale the silent way
 * a PNG does.
 *
 * Every measurement here is transcribed from the app's own components rather
 * than eyeballed from a screenshot — the first version of this file was
 * guessed from two components and drifted badly, missing the rail, the
 * toolbar, the inline detail panel and the dock entirely. The sources are:
 *
 *   page.tsx        `grid-cols-[248px_1fr] grid-rows-[44px_1fr]`
 *   TitleBar.tsx    h-11, 88px left inset for the traffic lights
 *   Rail.tsx        the three-wave mark, search with its `/` badge, VIEWS,
 *                   the DHT/port footer
 *   LibraryToolbar  h-14, title + count, sort chips, primary action
 *   TorrentRow      58px rows, 18px ring, 180px progress, 86px rates
 *   ExpandedRow     pl-[52px], five stats, three chips, the piece strip
 *   PieceStrip      22px over 16px, 1px gaps, availability capped at 80% so a
 *                   zero-copy region always stands tallest
 *   Dock            min-h 116px, chart beside an auto-fit stat grid
 *
 * The data is plausible rather than real, and it is a busier library than any
 * one screenshot: a hero where every figure reads `0 B/s` shows nothing
 * working. The counts in the rail add up to the rows in the list, because a
 * detail like that being wrong is exactly what makes a mock look like a mock.
 */

/** Deterministic PRNG, so the strip is identical on every build. */
function rng(seed: number) {
  let s = seed;
  return () => {
    s = (s * 1664525 + 1013904223) % 4294967296;
    return s / 4294967296;
  };
}

const CELLS = 104;

const done = rng(20260830);
const pieces = Array.from({ length: CELLS }, (_, i) => {
  const head = i < CELLS * 0.42;
  const roll = done();
  if (head) return roll > 0.06 ? "verified" : "flight";
  if (roll > 0.62) return "verified";
  if (roll > 0.52) return "flight";
  return "empty";
});

/**
 * Copies of each region across connected peers.
 *
 * Thinning toward the tail with one region at zero — the shape the user guide
 * calls "a torrent heading for a stall".
 */
const avail = rng(77021);
const peak = 9;
const copies = Array.from({ length: CELLS }, (_, i) => {
  const thinning = 1 - (i / CELLS) * 0.62;
  return Math.max(1, Math.round((2 + avail() * 7) * thinning));
});
copies[84] = 0;
copies[85] = 0;

/** Throughput history for the dock chart, 60 samples. */
const flow = rng(4242);
const history = Array.from({ length: 60 }, (_, i) => {
  const ramp = Math.min(1, i / 14);
  return {
    down: (4.4 + flow() * 2.6) * 1e6 * ramp,
    up: (0.7 + flow() * 0.9) * 1e6 * ramp,
  };
});

const views = [
  { label: "All torrents", icon: "files", count: 5, current: true },
  { label: "Downloading", icon: "arrow-down", count: 2 },
  { label: "Seeding", icon: "arrow-up", count: 2 },
  { label: "Needs attention", icon: "alert-triangle", count: 1 },
  { label: "Completed", icon: "check-circle", count: 2 },
  { label: "Paused & queued", icon: "pause", count: 1 },
];

const rows = [
  {
    name: "ubuntu-24.04.1-desktop-amd64.iso",
    size: "5.70 GB",
    detail: "61% · 12 min left",
    percent: 61,
    state: "downloading",
    down: "6.6 MB/s",
    up: "1.2 MB/s",
    peers: "24 / 106",
    health: "healthy",
    healthLabel: "Healthy",
    selected: true,
  },
  {
    name: "debian-13.6.0-arm64-netinst.iso",
    size: "735 MB",
    detail: "seeding to 12 of 342 known peers",
    percent: 100,
    state: "seeding",
    down: "0 B/s",
    up: "3.9 MB/s",
    peers: "12 / 342",
    health: "seeding",
    healthLabel: "Seeding",
  },
  {
    name: "Fedora-Workstation-Live-41-1.4.x86_64.iso",
    size: "2.23 GB",
    detail: "complete · ratio 2.14",
    percent: 100,
    state: "seeding",
    down: "0 B/s",
    up: "1.4 MB/s",
    peers: "7 / 88",
    health: "seeding",
    healthLabel: "Seeding",
  },
  {
    name: "AlmaLinux-9.4-x86_64-dvd.iso",
    size: "11.4 GB",
    detail: "paused at 88%",
    percent: 88,
    state: "paused",
    down: "0 B/s",
    up: "0 B/s",
    peers: "0 / 41",
    health: "idle",
    healthLabel: "Idle",
  },
  {
    name: "rocky-9.4-x86_64-minimal.iso",
    size: "2.44 GB",
    detail: "72% · no peer holds 3.1% of pieces",
    percent: 72,
    state: "downloading",
    down: "0 B/s",
    up: "184 KB/s",
    peers: "9 / 63",
    health: "none",
    healthLabel: "No seeds",
  },
];

const sorts = ["Activity", "Recently added", "Size"];

const dockStats = [
  { label: "Active", value: "4 of 5" },
  { label: "Session down", value: "12.9 GB" },
  { label: "Session up", value: "3.71 GB" },
  { label: "Share ratio", value: "0.29" },
  { label: "Connected peers", value: "52" },
  { label: "Known peers", value: "640" },
  { label: "DHT nodes", value: "1018" },
  { label: "Uptime", value: "41 min" },
];

/** 16-grid icon paths, lifted from the app's `Icon.tsx`. */
const ICONS: Record<string, string> = {
  files: "M4 2.4h5l3 3v8.2H4zM9 2.4v3.2h3",
  "arrow-down": "M8 2.6v8.4M4.6 7.6 8 11l3.4-3.4M3 13.4h10",
  "arrow-up": "M8 13.4V5M4.6 8.4 8 5l3.4 3.4M3 2.6h10",
  "alert-triangle": "M8 2.2 14.8 13.8H1.2zM8 6.4v3.2M8 11.8v.1",
  "check-circle":
    "M8 2.2a5.8 5.8 0 1 0 0 11.6 5.8 5.8 0 0 0 0-11.6zM5.4 8.2l1.9 1.9 3.5-4",
  pause: "M6.2 3.6v8.8M9.8 3.6v8.8",
  search: "M11.3 7a4.3 4.3 0 1 1-8.6 0 4.3 4.3 0 0 1 8.6 0m-1.1 3.2 3 3",
  plus: "M8 3.5v9M3.5 8h9",
  settings:
    "M2.4 5.2h3.2M9.2 5.2h4.4M2.4 10.8h4.4M10 10.8h3.6M8.6 5.2a1.4 1.4 0 1 1-2.8 0 1.4 1.4 0 0 1 2.8 0M9.6 10.8a1.4 1.4 0 1 1-2.8 0 1.4 1.4 0 0 1 2.8 0",
  "chevron-right": "m6.2 4 4 4-4 4",
};

/** Motion parameters handed to the client script. */
const motion = rows.map((r) => ({
  gain: r.state === "downloading" && r.down !== "0 B/s" ? 0.11 : 0,
  down: r.down,
  up: r.up,
}));

/** Builds the two chart polylines from the seeded history. */
const W = 320;
const H = 88;
const ceiling = 9e6;
const pointsFor = (key: "down" | "up") =>
  history
    .map((h, i) => {
      const x = (i / (history.length - 1)) * W;
      const y = H - Math.min(1, h[key] / ceiling) * (H - 6) - 3;
      return `${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(" ");
const downPoints = pointsFor("down");
const upPoints = pointsFor("up");
---

<div
  class="app"
  data-app
  role="img"
  aria-label="The Flume window. A sidebar lists views with counts; five Linux distribution torrents are in the library, one selected and expanded to show its piece map, the peers contributing to it, and a plain-language note about what is limiting it. A dock along the bottom charts session throughput beside eight session statistics."
>
  <!-- ── title bar ────────────────────────────────────────────── -->
  <div class="bar">
    <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="bar__name">Flume</span>
    <span class="bar__rates">
      <span class="bar__dl">
        <svg viewBox="0 0 16 16" width="13" height="13"
          ><path d={ICONS["arrow-down"]}></path></svg
        >
      </span>
      <span class="num" data-total-down>6.6 MB/s</span>
      <span class="bar__ul">
        <svg viewBox="0 0 16 16" width="13" height="13"
          ><path d={ICONS["arrow-up"]}></path></svg
        >
      </span>
      <span class="num" data-total-up>5.5 MB/s</span>
    </span>
  </div>

  <div class="body">
    <!-- ── rail ───────────────────────────────────────────────── -->
    <aside class="rail">
      <div class="rail__head">
        <div class="rail__brand">
          <svg
            class="mark"
            viewBox="0 0 24 24"
            width="22"
            height="22"
            aria-hidden="true"
          >
            <path d="M3 7.5c2.2-1.9 4.4-1.9 6.6 0s4.4 1.9 6.6 0 4.4-1.9 4.8 0"
            ></path>
            <path
              d="M3 13c2.2-1.9 4.4-1.9 6.6 0s4.4 1.9 6.6 0 4.4-1.9 4.8 0"
              opacity="0.62"></path>
            <path
              d="M3 18.5c2.2-1.9 4.4-1.9 6.6 0s4.4 1.9 6.6 0 4.4-1.9 4.8 0"
              opacity="0.32"></path>
          </svg>
          <span class="rail__word">Flume</span>
          <span class="rail__health"></span>
        </div>

        <div class="search">
          <span class="search__icon">
            <svg viewBox="0 0 16 16" width="14" height="14"
              ><path d={ICONS.search}></path></svg
            >
          </span>
          <span class="search__input">Search library</span>
          <span class="num search__key">/</span>
        </div>
      </div>

      <nav class="views">
        <p class="views__label">Views</p>
        {
          views.map((v) => (
            <span class:list={["view", v.current && "is-current"]}>
              <span class="view__icon">
                <svg viewBox="0 0 16 16" width="16" height="16">
                  <path d={ICONS[v.icon]} />
                </svg>
              </span>
              <span class="view__name">{v.label}</span>
              <span class="num view__count">{v.count}</span>
            </span>
          ))
        }
      </nav>

      <div class="net">
        <span class="net__row">
          <i class="net__dot"></i>DHT · <span class="num" data-dht>1,018</span> nodes
        </span>
        <span class="net__row">
          <i class="net__dot"></i>Port <span class="num">42221</span> open
        </span>
      </div>
    </aside>

    <!-- ── main column ────────────────────────────────────────── -->
    <div class="main">
      <div class="toolbar">
        <h2 class="toolbar__title">All torrents</h2>
        <span class="num toolbar__count">5 items</span>
        <span class="toolbar__spacer"></span>
        <span class="chips">
          {
            sorts.map((s, i) => (
              <span class:list={["chip", i === 0 && "is-on"]}>{s}</span>
            ))
          }
          <span class="chip chip--icon">
            <svg viewBox="0 0 16 16" width="14" height="14"
              ><path d={ICONS.settings}></path></svg
            >
          </span>
        </span>
        <span class="add">
          <svg viewBox="0 0 16 16" width="15" height="15"
            ><path d={ICONS.plus}></path></svg
          >
          Add torrent
        </span>
      </div>

      <div class="cols">
        <span class="col col--name">Name</span>
        <span class="col col--prog">Progress</span>
        <span class="col col--rate">Down</span>
        <span class="col col--rate">Up</span>
        <span class="col col--peers">Peers</span>
        <span class="col col--health">Swarm health</span>
      </div>

      <div class="list">
        {
          rows.map((row) => (
            <>
              <div class:list={["row", row.selected && "is-selected"]} data-row>
                <span class:list={["ring", `is-${row.state}`]}>
                  <svg viewBox="0 0 16 16" width="11" height="11">
                    <path
                      d={
                        ICONS[
                          row.state === "seeding"
                            ? "arrow-up"
                            : row.state === "paused"
                              ? "pause"
                              : "arrow-down"
                        ]
                      }
                    />
                  </svg>
                </span>

                <span class="row__name">
                  <span class="row__title">{row.name}</span>
                  <span class="row__meta">
                    <span class="num">{row.size}</span>
                    <span class="row__sep">·</span>
                    <span class="row__detail">{row.detail}</span>
                  </span>
                </span>

                <span class="row__prog">
                  <span class="track">
                    <span
                      class:list={["fill", `is-${row.state}`]}
                      style={`width:${row.percent}%`}
                    />
                  </span>
                  <span class="num row__pct">{row.percent}%</span>
                </span>

                <span
                  class:list={[
                    "num",
                    "row__rate",
                    row.down === "0 B/s" && "is-zero",
                  ]}
                >
                  {row.down}
                </span>
                <span
                  class:list={[
                    "num",
                    "row__rate",
                    "is-up",
                    row.up === "0 B/s" && "is-zero",
                  ]}
                >
                  {row.up}
                </span>
                <span class="num row__peers">{row.peers}</span>

                <span class="row__health">
                  <span class:list={["hchip", `is-${row.health}`]}>
                    <span class="hchip__dot" aria-hidden="true" />
                    {row.healthLabel}
                  </span>
                </span>
              </div>

              {row.selected && (
                <div class="detail">
                  <div class="detail__top">
                    <span class="stat">
                      <span class="stat__l">Downloaded</span>
                      <span class="num stat__v" data-downloaded>
                        3.48 GB
                      </span>
                    </span>
                    <span class="stat">
                      <span class="stat__l">Remaining</span>
                      <span class="num stat__v" data-remaining>
                        2.22 GB
                      </span>
                    </span>
                    <span class="stat">
                      <span class="stat__l">Ratio</span>
                      <span class="num stat__v">0.18</span>
                    </span>
                    <span class="stat">
                      <span class="stat__l">Pieces</span>
                      <span class="num stat__v">
                        <span data-verified>2,847</span> of 4,668
                      </span>
                    </span>
                    <span class="stat stat--wide">
                      <span class="stat__l">Saving to</span>
                      <span class="stat__v stat__v--path">
                        /Users/you/Downloads
                      </span>
                    </span>
                    <span class="detail__acts">
                      <span class="chip">Pause</span>
                      <span class="chip">Reveal in folder</span>
                      <span class="chip is-on">
                        Open details
                        <svg viewBox="0 0 16 16" width="12" height="12">
                          <path d={ICONS["chevron-right"]} />
                        </svg>
                      </span>
                    </span>
                  </div>

                  <div class="strip" data-strip>
                    {pieces.map((p) => (
                      <span class:list={["cell", `is-${p}`]} />
                    ))}
                  </div>
                  <div class="strip strip--avail">
                    {copies.map((c) => (
                      <span
                        class:list={["abar", c === 0 && "is-zero"]}
                        style={`height:${c === 0 ? 100 : Math.max(12, (c / peak) * 80)}%`}
                      />
                    ))}
                  </div>

                  <div class="legend">
                    <span class="legend__i">
                      <i class="sw is-verified" />
                      Verified
                    </span>
                    <span class="legend__i">
                      <i class="sw is-flight" />
                      In flight
                    </span>
                    <span class="legend__i">
                      <i class="sw is-empty" />
                      Not yet requested
                    </span>
                    <span class="legend__note">
                      One region is held by no connected peer.
                    </span>
                  </div>

                  <div class="detail__bottom">
                    <div class="contrib">
                      <p class="detail__h">Top contributors</p>
                      <span class="contrib__row">
                        <span class="contrib__n">qBittorrent 5.2</span>
                        <span class="num contrib__v">2.9 MB/s</span>
                      </span>
                      <span class="contrib__row">
                        <span class="contrib__n">Transmission 4.1</span>
                        <span class="num contrib__v">1.8 MB/s</span>
                      </span>
                      <span class="contrib__row">
                        <span class="contrib__n">libtorrent 2.0</span>
                        <span class="num contrib__v">1.1 MB/s</span>
                      </span>
                    </div>

                    <div class="note">
                      <span class="note__icon">
                        <svg viewBox="0 0 16 16" width="15" height="15">
                          <path d={ICONS["check-circle"]} />
                        </svg>
                      </span>
                      <span class="note__body">
                        <strong>Held at your download cap</strong>
                        <span>
                          You are getting all 6.6 MB/s you allowed. Raising the
                          limit in Settings is the only thing that would make
                          this faster — the swarm has more to give.
                        </span>
                      </span>
                    </div>
                  </div>
                </div>
              )}
            </>
          ))
        }
      </div>

      <!-- ── dock ─────────────────────────────────────────────── -->
      <div class="dock">
        <div class="chart">
          <div class="chart__head">
            <span class="chart__label">Session throughput · last 60 s</span>
            <span class="chart__key"><i class="sw is-down"></i>Download</span>
            <span class="chart__key"><i class="sw is-up"></i>Upload</span>
            <span class="chart__peak"
              ><i class="rule"></i>Peak <span class="num">9.0 MB/s</span></span
            >
          </div>
          <svg
            class="chart__svg"
            viewBox={`0 0 ${W} ${H}`}
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <polyline class="chart__line chart__line--down" points={downPoints}
            ></polyline>
            <polyline class="chart__line chart__line--up" points={upPoints}
            ></polyline>
          </svg>
        </div>

        <div class="stats">
          {
            dockStats.map((s) => (
              <span class="dstat">
                <span class="dstat__l">{s.label}</span>
                <span class="num dstat__v">{s.value}</span>
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ motion }}>
  /*
   * Brings the replica to life at 1 Hz — the app's own telemetry rate.
   *
   * Not decoration. Every competitor shows their client as a still
   * photograph; ticking the figures at the rate the real app ticks them also
   * demonstrates why every number is set in tabular figures, because the
   * columns do not move as the digits change.
   *
   * Stops before it starts under `prefers-reduced-motion`, leaving the
   * build-time render on screen — that state is complete on its own. Runs only
   * while on screen. Rates random-walk around their starting value so they
   * read as a measurement rather than as noise.
   */
  (function () {
    const root = document.querySelector("[data-app]");
    if (!root) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const rows = Array.from(root.querySelectorAll("[data-row]"));
    const cells = Array.from(root.querySelectorAll("[data-strip] .cell"));
    const dht = root.querySelector("[data-dht]");
    const verified = root.querySelector("[data-verified]");
    const downloaded = root.querySelector("[data-downloaded]");
    const remaining = root.querySelector("[data-remaining]");
    const totalDown = root.querySelector("[data-total-down]");
    const totalUp = root.querySelector("[data-total-up]");

    function parseRate(text) {
      const v = parseFloat(text);
      if (!Number.isFinite(v)) return 0;
      if (text.includes("MB")) return v * 1e6;
      if (text.includes("KB")) return v * 1e3;
      return v;
    }

    function formatSpeed(bps) {
      if (!Number.isFinite(bps) || bps <= 0) return "0 B/s";
      if (bps >= 100000) {
        const v = bps / 1e6;
        return `${v.toFixed(v < 100 ? 1 : 0)} MB/s`;
      }
      if (bps >= 1000) return `${Math.round(bps / 1e3)} KB/s`;
      return `${Math.round(bps)} B/s`;
    }

    function formatBytes(bytes) {
      const units = ["B", "KB", "MB", "GB"];
      const e = Math.min(Math.floor(Math.log(bytes) / Math.log(1000)), 3);
      const v = bytes / 1000 ** e;
      return `${v.toFixed(v < 10 ? 2 : v < 100 ? 1 : 0)} ${units[e]}`;
    }

    function formatDuration(s) {
      s = Math.max(0, Math.round(s));
      if (s >= 3600)
        return `${Math.floor(s / 3600)} h ${String(Math.floor((s % 3600) / 60)).padStart(2, "0")} min`;
      if (s >= 60)
        return `${Math.floor(s / 60)} min ${String(s % 60).padStart(2, "0")} s`;
      return `${s} s`;
    }

    function walk(value, base, spread) {
      const next = value + (Math.random() - 0.5) * base * spread;
      return Math.min(base * 1.35, Math.max(base * 0.55, next));
    }

    const TOTAL = 5.7e9;
    const state = motion.map((m) => ({
      ...m,
      downBps: parseRate(m.down),
      upBps: parseRate(m.up),
    }));
    let percent = 61;

    function tick() {
      let sumDown = 0;
      let sumUp = 0;

      state.forEach((row, i) => {
        const el = rows[i];
        if (!el) return;

        if (row.gain > 0) {
          const pct = Math.min(
            99.4,
            parseFloat(el.querySelector(".fill").style.width) + row.gain,
          );
          el.querySelector(".fill").style.width = `${pct}%`;
          el.querySelector(".row__pct").textContent = `${Math.floor(pct)}%`;
          if (i === 0) percent = pct;
        }

        if (row.downBps > 0)
          row.downBps = walk(row.downBps, parseRate(row.down), 0.22);
        if (row.upBps > 0) row.upBps = walk(row.upBps, parseRate(row.up), 0.3);
        sumDown += row.downBps;
        sumUp += row.upBps;

        const rates = el.querySelectorAll(".row__rate");
        if (rates[0] && row.downBps > 0)
          rates[0].textContent = formatSpeed(row.downBps);
        if (rates[1] && row.upBps > 0)
          rates[1].textContent = formatSpeed(row.upBps);
      });

      if (totalDown) totalDown.textContent = formatSpeed(sumDown);
      if (totalUp) totalUp.textContent = formatSpeed(sumUp);

      // The meta line's ETA is recomputed from the rate actually on screen, so
      // the sentence and the column can never contradict each other.
      const lead = rows[0];
      if (lead) {
        const left = ((100 - percent) / state[0].gain) * 1;
        lead.querySelector(".row__detail").textContent =
          `${Math.floor(percent)}% · ${formatDuration(left)} left`;
      }

      if (downloaded)
        downloaded.textContent = formatBytes((percent / 100) * TOTAL);
      if (remaining)
        remaining.textContent = formatBytes((1 - percent / 100) * TOTAL);

      // The strip is driven by the selected torrent's progress rather than
      // ticking on its own. Left to promote cells freely it saturates in about
      // a minute, leaving a full strip above a bar reading 63% and a legend
      // with no in-flight or not-requested cells left to point at.
      const target = Math.round((percent / 100) * cells.length);
      let now = cells.filter((c) => c.classList.contains("is-verified")).length;
      while (now < target) {
        const flight = cells.filter((c) => c.classList.contains("is-flight"));
        const pool = flight.length
          ? flight
          : cells.filter((c) => c.classList.contains("is-empty"));
        if (!pool.length) break;
        pool[Math.floor(Math.random() * pool.length)].className =
          "cell is-verified";
        now += 1;
      }

      const flying = cells.filter((c) =>
        c.classList.contains("is-flight"),
      ).length;
      const empty = cells.filter((c) => c.classList.contains("is-empty"));
      for (let n = flying; n < 9 && empty.length; n++) {
        const i = Math.floor(Math.random() * empty.length);
        empty[i].className = "cell is-flight";
        empty.splice(i, 1);
      }

      if (verified)
        verified.textContent = Math.round(
          (percent / 100) * 4668,
        ).toLocaleString();
      if (dht)
        dht.textContent = (
          1010 + Math.floor(Math.random() * 16)
        ).toLocaleString();
    }

    let timer = null;
    new IntersectionObserver(
      (entries) => {
        const visible = entries.some((e) => e.isIntersecting);
        if (visible && timer === null) timer = window.setInterval(tick, 1000);
        else if (!visible && timer !== null) {
          window.clearInterval(timer);
          timer = null;
        }
      },
      { threshold: 0.08 },
    ).observe(root);
  })();
</script>

