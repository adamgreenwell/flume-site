---
import Logo from "./Logo.astro";

const year = new Date().getFullYear();

const columns = [
  {
    heading: "Product",
    links: [
      { href: "/download/", label: "Download" },
      { href: "/changelog/", label: "Changelog" },
      {
        href: "https://github.com/adamgreenwell/flume/wiki/Roadmap",
        label: "Roadmap",
      },
    ],
  },
  {
    heading: "Documentation",
    links: [
      {
        href: "https://github.com/adamgreenwell/flume/wiki/Getting-Started",
        label: "Getting started",
      },
      {
        href: "https://github.com/adamgreenwell/flume/wiki/User-Guide",
        label: "User guide",
      },
      {
        href: "https://github.com/adamgreenwell/flume/wiki/Architecture",
        label: "Architecture",
      },
      {
        href: "https://github.com/adamgreenwell/flume/wiki/Development-Setup",
        label: "Build from source",
      },
    ],
  },
  {
    heading: "Project",
    links: [
      { href: "https://github.com/adamgreenwell/flume", label: "Source" },
      { href: "/contribute/", label: "Contribute" },
      {
        href: "https://github.com/adamgreenwell/flume/issues",
        label: "Issues",
      },
      {
        href: "https://github.com/adamgreenwell/flume/blob/main/SECURITY.md",
        label: "Security",
      },
      {
        href: "https://github.com/adamgreenwell/flume/blob/main/LICENSE",
        label: "Licence",
      },
      { href: "/privacy/", label: "Privacy" },
    ],
  },
];
---

<footer class="footer">
  <div class="wrap footer__inner">
    <div class="footer__brand">
      <Logo size={24} wordmark />
      <p class="footer__tagline">
        A beautiful, cross-platform BitTorrent client.
      </p>
      <p class="footer__legal">
        © {year} Adam Greenwell. Apache-2.0.<br />
        Embeds <a href="https://github.com/ikatson/rqbit" rel="noopener"
          >librqbit</a
        >, also Apache-2.0.
      </p>
    </div>

    <nav class="footer__cols" aria-label="Footer">
      {
        columns.map((col) => (
          <div class="footer__col">
            <h2 class="eyebrow">{col.heading}</h2>
            <ul class="footer__list">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    rel={link.href.startsWith("http") ? "noopener" : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="wrap">
    <p class="footer__note">
      Flume is unrelated to the <a
        href="https://crates.io/crates/flume"
        rel="noopener">flume crate</a
      > (an MPMC channel library) and to <a
        href="https://flume.dev"
        rel="noopener">flume.dev</a
      > (a React node editor).
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: 6rem;
    padding-block: 3.5rem 2.5rem;
    border-top: 1px solid var(--line);
    background: var(--bg-1);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 2fr);
    gap: 3rem;
    align-items: start;
  }

  .footer__tagline {
    margin-top: 0.9rem;
    color: var(--fg-1);
    font-size: var(--t-small);
    max-width: 30ch;
  }

  .footer__legal {
    margin-top: 1.25rem;
    color: var(--fg-3);
    font-size: var(--t-micro);
    line-height: 1.75;
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .footer__list {
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }

  .footer__list a,
  .footer__legal a,
  .footer__note a {
    color: var(--fg-2);
    font-size: var(--t-small);
    text-decoration: none;
    transition: color 0.14s ease;
  }

  .footer__legal a,
  .footer__note a {
    color: var(--fg-2);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: var(--line-2);
    font-size: inherit;
  }

  .footer__list a:hover,
  .footer__legal a:hover,
  .footer__note a:hover {
    color: var(--acc);
  }

  .footer__note {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--fg-3);
    font-size: var(--t-micro);
    max-width: 72ch;
  }

  @media (max-width: 820px) {
    .footer__inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 520px) {
    .footer__cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.75rem;
    }
  }
</style>
