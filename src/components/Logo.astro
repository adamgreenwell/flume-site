---
/**
 * The Flume mark.
 *
 * A supplied raster asset rather than inline SVG, which has two consequences
 * worth stating rather than discovering:
 *
 *   1. It does not follow the theme. The mark carries its own blues and is
 *      used unmodified on both grounds — it was checked against the dark
 *      `bg-0` and the light `bg-1` and holds on each, the cyan arc carrying it
 *      on dark and the navy on light. Nothing here should try to recolour it.
 *   2. It has gradients and bevels, so it is served at a size close to the one
 *      it is drawn at. `logo.png` is 128px, which covers every place the site
 *      uses it (24–34px) at up to 4× density for 20 KB. The 1600px original
 *      lives in `brand/` and is the source for regenerating these.
 *
 * `width`/`height` are set on the element so the header does not reflow when
 * the image lands.
 */
interface Props {
  /** Edge length of the mark in pixels. */
  size?: number;
  /** Render the wordmark beside the mark. */
  wordmark?: boolean;
  /** Extra classes on the wrapper. */
  class?: string;
}

const { size = 28, wordmark = false, class: klass = "" } = Astro.props;
---

<span class:list={["logo", klass]}>
  <img
    src="/logo.png"
    width={size}
    height={size}
    alt={wordmark ? "" : "Flume"}
    decoding="async"
  />
  {wordmark && <span class="logo__word">Flume</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .logo img {
    flex: none;
  }

  /*
   * The wordmark is set tighter than body copy. At display sizes Instrument
   * Sans's default fit opens up noticeably, and the mark beside it reads as a
   * separate object unless the letters are drawn back together.
   */
  .logo__word {
    color: var(--fg-0);
    font-size: 1.28rem;
    font-weight: 600;
    letter-spacing: -0.026em;
    line-height: 1;
  }
</style>
