---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StructuredData from "../components/StructuredData.astro";
import { verificationTags } from "../lib/verification";

interface Props {
  /** Page title, before the site suffix. */
  title: string;
  /** Meta description and Open Graph description. */
  description: string;
  /** Path for `og:image`, relative to the site root. */
  image?: string;
  /** Suppress the site-name suffix, for the home page. */
  bareTitle?: boolean;
  /**
   * Latest version, for the `SoftwareApplication` node.
   *
   * Passed down rather than fetched here: the pages that know it have already
   * called `latestRelease()`, and `releases.ts` does not memoise, so resolving
   * it in the layout would spend a GitHub API call per page of the build.
   */
  version?: string;
  /** The platform a per-platform download page is about, for the JSON-LD. */
  platform?: { slug: string; label: string; operatingSystem: string };
  /** Breadcrumb trail for the JSON-LD, root first. */
  breadcrumb?: { name: string; path: string }[];
}

const {
  title,
  description,
  image = "/og.png",
  bareTitle = false,
  version,
  platform,
  breadcrumb,
} = Astro.props;

const fullTitle = bareTitle ? title : `${title} — Flume`;

/**
 * The Google Analytics bootstrap, held as a string and injected with
 * `set:html` into a childless <script>.
 *
 * This has now been wrong twice in two different ways, so the shape is
 * deliberate. Written as `{\`…\`}` the braces and backticks were emitted into
 * the page verbatim — an `is:inline` body is passed through untouched — and the
 * browser got a block containing a discarded string: valid JavaScript that does
 * nothing, while the tag sat in the HTML looking perfectly correct. Written as
 * raw JS it worked, but Prettier reflowed it, and a formatter rewrapping live
 * JavaScript is a bug waiting for the wrong line break.
 *
 * A string in the frontmatter is immune to both.
 */
const GA_ID = "G-KNGWP21KK5";
const gaBootstrap = [
  "window.dataLayer = window.dataLayer || [];",
  "function gtag(){window.dataLayer.push(arguments);}",
  "gtag('js', new Date());",
  `gtag('config', '${GA_ID}');`,
].join("\n");
const verifications = verificationTags();
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!--
      A PNG rather than an SVG favicon. The mark has gradients and bevelled
      edges, so it is a raster asset; inlining it as a data URI in an SVG
      wrapper would cost more than it is worth for a 32px slot.
    -->
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <StructuredData
      version={version}
      platform={platform}
      breadcrumb={breadcrumb}
    />

    {
      /* Ownership proofs for the webmaster consoles. See lib/verification.ts. */
    }
    {verifications.map((v) => <meta name={v.name} content={v.content} />)}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Flume" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <!--
      Preloaded because the type ramp was measured against these metrics and a
      swap after first paint re-lays the whole page. Only the two faces that
      appear above the fold: the UI variable font, and mono 500, which the
      version and size figures use.
    -->
    <link
      rel="preload"
      href="/fonts/instrument-sans-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-latin-500-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!--
      Theme, applied before first paint.

      Inline and render-blocking on purpose: resolving this in a module script
      would run after the first frame, so a visitor who chose light would watch
      the page load dark and then flip. Mirrors the app's own rule — an
      explicit choice wins, and "system" removes the attribute entirely so the
      prefers-color-scheme media query stays authoritative and keeps following
      the OS live.
    -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("flume-theme");
          if (saved === "light" || saved === "dark") {
            document.documentElement.setAttribute("data-theme", saved);
          }
        } catch (e) {
          /* Private mode, or storage disabled. System preference stands. */
        }
      })();
    </script>

    {
      /*
       * Google Analytics 4.
       *
       * `is:inline` on both: Astro would otherwise try to bundle them, and the
       * gtag loader has to stay a plain async script pointing at Google's
       * origin.
       *
       * Production only. Without the guard every `npm run dev` reload and every
       * headless screenshot lands in the property, and localhost traffic is
       * indistinguishable from real traffic once it is in there.
       *
       * Two tools on purpose. Umami is self-hosted and cookieless, so it works
       * for the visitors who block Google — which, on a torrent client's site,
       * is a meaningful share of them.
       *
       * Note both measure the *website*. The claims on the home page about
       * nothing reporting back are about the app, which ships no analytics SDK,
       * no updater and no account — verified against the tree before they were
       * written. Worth keeping that distinction sharp if the copy ever moves.
       */
    }
    {
      import.meta.env.PROD && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}
          />
          <script is:inline set:html={gaBootstrap} />

          <script
            is:inline
            defer
            src="https://umami.faustdesignkompanie.com/script.js"
            data-website-id="6487dfd4-01e1-4935-942d-80c5ac318d93"
          />
        </>
      )
    }
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--bg-2);
    border: 1px solid var(--line-2);
    border-radius: var(--r-md);
    font-size: var(--t-small);
    font-weight: 600;
    text-decoration: none;
  }

  .skip:focus {
    left: 1rem;
    top: 1rem;
  }
</style>
