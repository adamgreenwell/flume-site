---
import { marked } from "marked";
import Base from "../layouts/Base.astro";
import { allReleases, formatBytes } from "../lib/releases";
import "../styles/prose.css";

const releases = await allReleases();

/**
 * Release notes are markdown, rendered here at build time.
 *
 * `marked` runs with raw HTML disabled. Release bodies are written by the
 * maintainer and partly generated by GitHub, so this is not a hostile input —
 * but it is text fetched over the network and pasted into a page, and there
 * is no reason for it to be able to carry markup of its own.
 */
marked.setOptions({ gfm: true, breaks: false });

const rendered = await Promise.all(
  releases.map(async (release) => ({
    release,
    html: await marked.parse(release.body.replace(/<[^>]*>/g, ""), {
      async: true,
    }),
    date: new Date(release.publishedAt).toLocaleDateString("en-GB", {
      day: "numeric",
      month: "long",
      year: "numeric",
    }),
  })),
);
---

<Base
  title="Changelog"
  description="Every Flume release, with notes and downloads."
>
  <section class="wrap head">
    <p class="eyebrow">Changelog</p>
    <h1 class="head__title">Every release.</h1>
    <p class="lead head__lead">
      Pulled from GitHub Releases when the site is built, so this page and the
      tags cannot disagree.
    </p>
  </section>

  <div class="wrap">
    {
      rendered.length === 0 ? (
        <div class="empty">
          <h2 class="empty__title">Nothing released yet</h2>
          <p class="empty__body">
            Flume has not cut its first tagged release. The roadmap tracks what
            is done and what is left before 1.0, and the repository's commit
            history is public.
          </p>
          <div class="empty__links">
            <a class="btn btn--primary" href="/docs/roadmap/">
              Read the roadmap
            </a>
            <a
              class="btn btn--ghost"
              href="https://github.com/adamgreenwell/flume/releases"
              rel="noopener"
            >
              Watch releases on GitHub
            </a>
          </div>
        </div>
      ) : (
        <ol class="releases">
          {rendered.map(({ release, html, date }) => (
            <li class="release">
              <div class="release__meta">
                <h2 class="release__tag num" id={release.tag}>
                  {release.tag}
                </h2>
                <p class="release__date">{date}</p>
                {release.prerelease && <p class="release__flag">Pre-release</p>}
              </div>

              <div class="release__body">
                <div class="prose" set:html={html} />

                {release.assets.length > 0 && (
                  <details class="downloads">
                    <summary class="downloads__summary">
                      {release.assets.length} downloads
                    </summary>
                    <ul class="downloads__list">
                      {release.assets.map((asset) => (
                        <li>
                          <a href={asset.url}>
                            <span class="num">{asset.name}</span>
                            <span class="num downloads__size">
                              {formatBytes(asset.size)}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </details>
                )}
              </div>
            </li>
          ))}
        </ol>
      )
    }
  </div>
</Base>

<style>
  .head {
    padding-top: clamp(2.5rem, 1rem + 5vw, 4.5rem);
  }

  .head__title {
    margin-top: 0.75rem;
    font-size: var(--t-display);
  }

  .head__lead {
    margin-top: 1rem;
    max-width: 58ch;
  }

  .releases {
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }

  .release {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
    padding-top: 2.5rem;
  }

  .release + .release {
    margin-top: 2.5rem;
    border-top: 1px solid var(--line);
  }

  .release:first-child {
    padding-top: 0;
  }

  .release__meta {
    position: sticky;
    top: 5.5rem;
    align-self: start;
  }

  .release__tag {
    font-size: 1.3rem;
    font-weight: 600;
    scroll-margin-top: 5.5rem;
  }

  .release__date {
    margin-top: 0.3rem;
    color: var(--fg-3);
    font-size: var(--t-small);
  }

  .release__flag {
    display: inline-block;
    margin-top: 0.6rem;
    padding: 0.15rem 0.5rem;
    border-radius: var(--r-sm);
    background: color-mix(in srgb, var(--warn) 15%, transparent);
    color: var(--warn);
    font-size: var(--t-micro);
    font-weight: 600;
  }

  /* Release notes open at h2, so the prose rule that gives every h2 a rule
     above it would put a line at the very top of each entry. */
  .release__body :global(.prose > h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .downloads {
    margin-top: 1.75rem;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--bg-1);
  }

  .downloads__summary {
    padding: 0.7rem 1rem;
    color: var(--fg-2);
    font-size: var(--t-small);
    font-weight: 500;
    cursor: pointer;
  }

  .downloads__list {
    margin: 0;
    padding: 0 1rem 0.85rem;
    list-style: none;
    display: grid;
    gap: 0.4rem;
  }

  .downloads__list a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--fg-2);
    font-size: var(--t-micro);
    text-decoration: none;
  }

  .downloads__list a:hover {
    color: var(--acc);
  }

  .downloads__size {
    color: var(--fg-3);
    white-space: nowrap;
  }

  /* ---- empty ---- */
  .empty {
    margin-top: 2.5rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--bg-1);
  }

  .empty__title {
    font-size: var(--t-title);
  }

  .empty__body {
    margin-top: 0.75rem;
    color: var(--fg-1);
    max-width: 62ch;
  }

  .empty__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding-inline: 1.25rem;
    border-radius: var(--r-md);
    font-size: var(--t-small);
    font-weight: 600;
    text-decoration: none;
  }

  .btn--primary {
    background: var(--acc);
    color: var(--on-acc);
  }

  .btn--primary:hover {
    background: var(--acc-hi);
  }

  .btn--ghost {
    border: 1px solid var(--line-2);
    color: var(--fg-0);
  }

  .btn--ghost:hover {
    background: var(--bg-2);
  }

  @media (max-width: 760px) {
    .release {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }
    .release__meta {
      position: static;
    }
  }
</style>
