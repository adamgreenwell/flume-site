---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import DocsNav from "../../components/DocsNav.astro";
import "../../styles/prose.css";

export async function getStaticPaths() {
  const pages = await getCollection("docs");
  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content, headings } = await render(page);

/**
 * On-page contents, from `##` only.
 *
 * `###` and below would double the length of the list on pages like the user
 * guide without helping anyone find anything — the h2s already name the
 * sections people arrive looking for.
 */
const toc = headings.filter((h) => h.depth === 2);

const source = `https://github.com/adamgreenwell/flume/blob/main/${page.data.source}`;
---

<Base
  title={page.data.title}
  description={`${page.data.title} — Flume documentation.`}
>
  <div class="wrap docs">
    <aside class="docs__side">
      <DocsNav current={page.id} />
    </aside>

    <article class="docs__main">
      <p class="eyebrow">{page.data.section}</p>
      <h1 class="docs__title">{page.data.title}</h1>

      <div class="prose">
        <Content />
      </div>

      <footer class="docs__foot">
        <a href={source} rel="noopener">Edit this page on GitHub →</a>
      </footer>
    </article>

    {
      toc.length > 1 && (
        <aside class="docs__toc" aria-label="On this page">
          <h2 class="eyebrow">On this page</h2>
          <ul class="toc__list">
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>
</Base>

<script>
  /*
   * Wraps every rendered table in a horizontal scroller.
   *
   * Done here rather than in the markdown because the source is mirrored to
   * the GitHub wiki, where a stray <div> would show up as literal markup. The
   * alternative — a rehype plugin — is the tidier answer if this list of
   * post-processing steps ever grows past one.
   */
  document.querySelectorAll(".prose table").forEach((table) => {
    if (table.parentElement?.classList.contains("table-scroll")) return;
    const wrap = document.createElement("div");
    wrap.className = "table-scroll";
    table.replaceWith(wrap);
    wrap.append(table);
  });
</script>

<style>
  .docs {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr) 190px;
    gap: clamp(2rem, 1rem + 3vw, 3.5rem);
    align-items: start;
    padding-block: clamp(2rem, 1rem + 3vw, 3.5rem);
  }

  .docs__side,
  .docs__toc {
    position: sticky;
    top: 5rem;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
  }

  .docs__title {
    margin-top: 0.6rem;
    margin-bottom: 2rem;
    font-size: clamp(1.9rem, 1.4rem + 2vw, 2.6rem);
  }

  .docs__foot {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .docs__foot a {
    color: var(--fg-2);
    font-size: var(--t-small);
    text-decoration: none;
  }

  .docs__foot a:hover {
    color: var(--acc);
  }

  .toc__list {
    display: grid;
    gap: 0.5rem;
    margin: 0.7rem 0 0;
    padding: 0;
    list-style: none;
  }

  .toc__list a {
    color: var(--fg-2);
    font-size: var(--t-micro);
    line-height: 1.45;
    text-decoration: none;
  }

  .toc__list a:hover {
    color: var(--acc);
  }

  @media (max-width: 1080px) {
    .docs {
      grid-template-columns: 200px minmax(0, 1fr);
    }
    .docs__toc {
      display: none;
    }
  }

  /*
   * Below 820px the sidebar stops being a sidebar and becomes an index above
   * the article. It is short enough to scroll past, and a drawer would need
   * JavaScript to open something a reader has already arrived at.
   */
  @media (max-width: 820px) {
    .docs {
      grid-template-columns: minmax(0, 1fr);
    }
    .docs__side {
      position: static;
      max-height: none;
      padding-bottom: 1.75rem;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
