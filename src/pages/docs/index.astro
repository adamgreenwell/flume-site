---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const pages = await getCollection("docs");

const sections = [...new Set(pages.map((p) => p.data.section))]
  .map((name) => ({
    name,
    pages: pages
      .filter((p) => p.data.section === name)
      .sort((a, b) => a.data.order - b.data.order),
  }))
  .sort((a, b) => a.pages[0].data.order - b.pages[0].data.order);

/**
 * One line of orientation per page.
 *
 * Written here rather than pulled from each document's first paragraph: those
 * open mid-thought because the wiki gives them a title of their own, and a
 * card that starts "Flume pins librqbit 9.0.0" tells a browsing reader
 * nothing about whether they want to click it.
 */
const blurbs: Record<string, string> = {
  "getting-started": "Installing, first run, and what your firewall needs.",
  "user-guide":
    "Adding torrents, reading the swarm verdicts, and what the piece map is telling you.",
  architecture: "The IPC contract, and why torrent data never reaches the UI.",
  "torrent-engine-notes":
    "librqbit v9 — what Flume relies on, and the patch it carries.",
  "design-system": "Tokens, type, and the rules new interface work follows.",
  "development-setup": "Prerequisites and the quality gate, per platform.",
  "ci-cd-and-releases": "What CI checks, and how a release is cut.",
  "signing-and-distribution":
    "What each OS says about an unsigned build, and how to get past it.",
  "platform-notes": "Per-platform behaviour and known differences.",
  "smoke-test-checklist": "What to verify on a platform for the first time.",
  roadmap: "What is done, what is next, and what is deliberately out of scope.",
};
---

<Base
  title="Documentation"
  description="Flume documentation — installing, using, and building a modern cross-platform BitTorrent client."
>
  <section class="wrap head">
    <p class="eyebrow">Documentation</p>
    <h1 class="head__title">Everything, written down.</h1>
    <p class="lead head__lead">
      The same source as the project wiki, kept in the repository and edited in
      the same commit as the code it describes.
    </p>
  </section>

  <div class="wrap sections">
    {
      sections.map((section) => (
        <section class="section">
          <h2 class="section__title">{section.name}</h2>
          <ul class="cards">
            {section.pages.map((page) => (
              <li>
                <a class="card" href={`/docs/${page.id}/`}>
                  <h3 class="card__title">{page.data.title}</h3>
                  <p class="card__body">{blurbs[page.id] ?? ""}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .head {
    padding-top: clamp(2.5rem, 1rem + 5vw, 4.5rem);
  }

  .head__title {
    margin-top: 0.75rem;
    font-size: var(--t-display);
  }

  .head__lead {
    margin-top: 1rem;
    max-width: 60ch;
  }

  .sections {
    display: grid;
    gap: 3rem;
    margin-top: 3rem;
  }

  .section__title {
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--t-title);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 0.75rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: block;
    height: 100%;
    padding: 1.25rem 1.3rem 1.35rem;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--bg-1);
    text-decoration: none;
    transition:
      border-color 0.14s ease,
      background-color 0.14s ease;
  }

  .card:hover {
    border-color: var(--line-2);
    background: var(--bg-2);
  }

  .card__title {
    font-size: 1.02rem;
    letter-spacing: -0.014em;
  }

  .card__body {
    margin-top: 0.5rem;
    font-size: var(--t-small);
    color: var(--fg-2);
  }
</style>
